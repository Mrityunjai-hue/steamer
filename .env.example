# Steamer Environment Configuration Template

# Database:
# - Local / VPS Docker: "file:./steamer.db" (SQLite)
# - Vercel Serverless: "postgresql://username:password@ep-xyz.neon.tech/steamer?sslmode=require" (e.g. Free Neon / Supabase / Vercel Postgres)
DATABASE_URL="file:./steamer.db"

# Security & Secrets:
JWT_SECRET="replace-with-a-random-64-character-secret"
ENCRYPTION_KEY="32-char-random-aes256gcm-secret-key"
ADMIN_EMAIL="admin@steamer.live"
ADMIN_INITIAL_PASSWORD="SecureAdminPassword#ChangeMe"

# Application Base URL:
# - On Vercel: If left unset, it automatically resolves to https://<your-project>.vercel.app
# - Explicit override: https://<your-project>.vercel.app (or custom domain)
NEXT_PUBLIC_APP_URL="https://steamer.vercel.app"

# Optional Cloudflare Turnstile Bot Protection:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
